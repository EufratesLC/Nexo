{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "node"],
  "rules": {
    "no-console": ["warn", { "allow": ["error"] }]
  },
  "overrides": [
    {
      "files": ["src/base/migracoes/cli.ts", "src/base/migracoes/ligacoes.ts", "src/**/*.test.ts", "testes/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist", "testes/isolamento"]
}
